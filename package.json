{
  "name": "comfy-cloud-axi",
  "version": "0.1.0",
  "packageManager": "pnpm@11.1.1",
  "description": "AXI-compliant Comfy Cloud CLI — token-efficient TOON output for AI generation workflows, jobs, and models",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/intelligentrascal/comfy-cloud-axi.git"
  },
  "keywords": [
    "comfy",
    "comfyui",
    "comfy-cloud",
    "cli",
    "agent",
    "axi",
    "toon",
    "generation",
    "image",
    "video"
  ],
  "bin": {
    "comfy-cloud-axi": "./dist/bin/comfy-cloud-axi.js"
  },
  "files": [
    "dist",
    "skills/comfy-cloud-axi",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"const fs=require('fs');const p='dist/bin/comfy-cloud-axi.js';const c=fs.readFileSync(p,'utf8');if(!c.startsWith('#!/usr/bin/env node'))fs.writeFileSync(p,'#!/usr/bin/env node\\n'+c)\"",
    "build:skill": "tsx scripts/build-skill.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx bin/comfy-cloud-axi.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"bin/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"bin/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@toon-format/toon": "^2.1.0",
    "axi-sdk-js": "^0.1.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^3.0.0",
    "yaml": "^2.9.0"
  }
}
